# Copie este arquivo para ".env" e ajuste os valores.

# --- Usando Neon (recomendado) ---
# No dashboard do Neon, clique em "Connection string". O Neon mostra a
# connection string PABPOOLEADA (com "-pooler" no host) por padrao - use-a em
# DATABASE_URL. Para pegar a versao SEM pooling (para DIRECT_URL), troque o
# seletor "Pooled connection" para "Direct connection" na mesma tela, ou
# remova o "-pooler" do host manualmente.
DATABASE_URL="postgresql://usuario:senha@ep-exemplo-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
DIRECT_URL="postgresql://usuario:senha@ep-exemplo.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# --- Usando PostgreSQL local, em vez do Neon ---
# Descomente e ajuste as duas linhas abaixo (podem ser iguais, ja que nao ha pooler):
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/eafi?schema=public"
# DIRECT_URL="postgresql://postgres:postgres@localhost:5432/eafi?schema=public"

# Porta em que o servidor Express vai rodar
PORT=3000

# Credenciais da area administrativa (autenticacao basica)
ADMIN_USER=admin
ADMIN_PASS=troque-esta-senha
